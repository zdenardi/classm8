generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
  runtime    = "deno"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int              @id @default(autoincrement())
  email             String           @unique
  firstName         String
  lastName          String
  role              Role             @default(STUDENT)
  clerkId           String           @unique
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  coursesInstructed Course[]
  scenesPerformed   UsersAndScenes[]
  enrollments       UsersInCourses[]
}

model Course {
  id           Int              @id @default(autoincrement())
  title        String
  studentLimit Int?
  instructorId Int
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  classes      Class[]
  instructor   User             @relation(fields: [instructorId], references: [id])
  students     UsersInCourses[]
}

model Class {
  id            Int               @id @default(autoincrement())
  courseId      Int
  location      String
  notes         String?
  streamingLink String
  startDate     DateTime
  endDate       DateTime
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  scenes        ScenesInClasses[]
}

model Scene {
  id         Int               @id @default(autoincrement())
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  duration   Int
  title      String
  notes      String?
  type       SceneTypes
  performers UsersAndScenes[]
  classes    ScenesInClasses[]

}

model UsersInCourses {
  userId   Int
  courseId Int
  hasPaid  Boolean @default(false)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id])

  @@id([userId, courseId])
}

model UsersAndScenes {
  userId  Int
  sceneId Int
  scene   Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sceneId])
}

model ScenesInClasses {
  classId  Int
  sceneId  Int
  approved Boolean @default(false)
  order    Int
  class    Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  scene    Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@id([classId, sceneId])
  @@unique([classId, order])
}

enum Role {
  ADMIN
  STUDENT
  MODERATOR
  INSTRUCTOR
}

enum SceneTypes {
  PLAY
  FILM
  MONOLOGUE
  SONG
  TELEVISION
  OTHER
}
